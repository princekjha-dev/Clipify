# ============================================================================
# CLIPIFY - API KEY CONFIGURATION
# ============================================================================
#
# HOW TO USE THIS FILE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in the API key(s) for the provider(s) you want to use
#   3. Leave unused providers empty or commented out
#   4. Never commit your .env file to version control!
#
# Set AI_PROVIDER to select your preferred provider when running Clipify:
#   export AI_PROVIDER=groq
#   python clipify.py --video video.mp4
AI_PROVIDER=groq
#
# PROVIDER QUICK-PICK GUIDE:
#   ┌──────────────────┬────────────┬──────────┬─────────┬──────────┐
#   │ Provider         │ Speed      │ Cost     │ Quality │ Privacy  │
#   ├──────────────────┼────────────┼──────────┼─────────┼──────────┤
#   │ OpenRouter       │ Fast       │ Free+    │ 92%     │ Cloud    │
#   │ Groq             │ Ultra-fast │ Free     │ 90%     │ Cloud    │
#   │ OpenAI           │ Moderate   │ Paid     │ 95%     │ Cloud    │
#   │ DeepSeek         │ Ultra-fast │ Very low │ 88%     │ Cloud    │
#   │ Google Gemini    │ Fast       │ Free+    │ 91%     │ Cloud    │
#   │ Anthropic Claude │ Moderate   │ Paid     │ 94%     │ Cloud    │
#   │ Mistral          │ Fast       │ Free+    │ 89%     │ Cloud    │
#   │ Cohere           │ Fast       │ Free+    │ 87%     │ Cloud    │
#   │ Together AI      │ Fast       │ Low      │ 88%     │ Cloud    │
#   │ Fireworks AI     │ Ultra-fast │ Low      │ 89%     │ Cloud    │
#   │ Perplexity       │ Fast       │ Paid     │ 90%     │ Cloud    │
#   │ xAI (Grok)       │ Fast       │ Paid     │ 91%     │ Cloud    │
#   │ Local (Ollama)   │ Fast       │ Free     │ 85%     │ 100%     │
#   └──────────────────┴────────────┴──────────┴─────────┴──────────┘
#
# ========le====================================================================


# ----------------------------------------------------------------------------
# OPTION 1: OpenRouter (RECOMMENDED — Multi-Model Gateway)
# ----------------------------------------------------------------------------
# Access 100+ models (Llama, Mistral, Claude, GPT, Gemma, etc.) via one key.
# Many free-tier models available — great starting point.
#
# Get your key : https://openrouter.ai/keys
# Pricing      : https://openrouter.ai/models (filter by "Free")
# Docs         : https://openrouter.ai/docs
#
# Format: sk-or-v1-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
#
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE


# ----------------------------------------------------------------------------
# OPTION 2: Groq (Ultra-Fast Inference — Free Tier Available)
# ----------------------------------------------------------------------------
# Runs open-source models (Llama 3, Mixtral, Gemma) at blazing speed
# using custom LPU hardware. Best for latency-sensitive workflows.
#
# Get your key : https://console.groq.com/keys
# Free limits  : https://console.groq.com/docs/rate-limits
# Supported models: llama3-8b-8192, mixtral-8x7b-32768, gemma-7b-it
#
# Format: gsk_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
#
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE


# ----------------------------------------------------------------------------
# OPTION 3: OpenAI (Highest Accuracy — Paid)
# ----------------------------------------------------------------------------
# Industry-standard models: GPT-4o, GPT-4-turbo, GPT-3.5-turbo.
# Best overall quality; recommended for production use.
#
# Get your key : https://platform.openai.com/api-keys
# Pricing      : https://openai.com/pricing
# Usage limits : https://platform.openai.com/account/limits
#
# Format: sk-proj-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
#
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE

# Optional: Override the default model (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o


# ----------------------------------------------------------------------------
# OPTION 4: DeepSeek (Cheapest Paid Option)
# ----------------------------------------------------------------------------
# Extremely low cost with strong reasoning performance.
# DeepSeek-V2 is competitive with GPT-4 at a fraction of the price.
#
# Get your key : https://platform.deepseek.com/api_keys
# Pricing      : https://platform.deepseek.com/api-docs/pricing
#
# Format: sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
#
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY_HERE


# ----------------------------------------------------------------------------
# OPTION 5: Google Gemini (Free Tier + Multimodal)
# ----------------------------------------------------------------------------
# Supports text, image, audio, and video natively.
# Gemini 1.5 Flash is free and very capable for most tasks.
#
# Get your key : https://aistudio.google.com/app/apikeys
# Pricing      : https://ai.google.dev/pricing
# Supported models: gemini-1.5-flash, gemini-1.5-pro, gemini-pro
#
# Format: AIzaSy-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
#
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE


# ----------------------------------------------------------------------------
# OPTION 6: Anthropic Claude (Best for Long Context & Reasoning)
# ----------------------------------------------------------------------------
# Claude 3.5 Sonnet/Haiku excel at nuanced understanding and instruction
# following. 200K context window. Great for long video transcripts.
#
# Get your key : https://console.anthropic.com/
# Pricing      : https://www.anthropic.com/pricing
# Supported models: claude-3-5-sonnet-20241022, claude-3-haiku-20240307
#
# Format: sk-ant-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
#
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY_HERE


# ----------------------------------------------------------------------------
# OPTION 7: Mistral AI (European, Open & Efficient)
# ----------------------------------------------------------------------------
# Strong open-weight models with excellent multilingual support.
# Free tier available via La Plateforme.
#
# Get your key : https://console.mistral.ai/api-keys
# Pricing      : https://mistral.ai/technology/#pricing
# Supported models: mistral-large-latest, mistral-small-latest, open-mistral-7b
#
# Format: XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
#
MISTRAL_API_KEY=YOUR_MISTRAL_API_KEY_HERE


# ----------------------------------------------------------------------------
# OPTION 8: Cohere (Best for RAG & Embeddings)
# ----------------------------------------------------------------------------
# Specialises in enterprise search, summarisation, and retrieval-augmented
# generation. Free trial key available with no credit card required.
#
# Get your key : https://dashboard.cohere.com/api-keys
# Pricing      : https://cohere.com/pricing
# Supported models: command-r-plus, command-r, command-light
#
# Format: XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
#
COHERE_API_KEY=YOUR_COHERE_API_KEY_HERE


# ----------------------------------------------------------------------------
# OPTION 9: Together AI (Cheap Open-Source Models)
# ----------------------------------------------------------------------------
# Run 100+ open-source models cheaply: Llama 3, Qwen, DBRX, etc.
# $1 free credit on sign-up; very low per-token pricing after.
#
# Get your key : https://api.together.xyz/settings/api-keys
# Pricing      : https://www.together.ai/pricing
#
# Format: XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
#
TOGETHER_API_KEY=YOUR_TOGETHER_API_KEY_HERE


# ----------------------------------------------------------------------------
# OPTION 10: Fireworks AI (Fastest Open-Source Inference)
# ----------------------------------------------------------------------------
# Purpose-built for speed. Llama 3.1, Mixtral, Phi-3 at very low latency.
# Free tier: 600K tokens/month.
#
# Get your key : https://fireworks.ai/account/api-keys
# Pricing      : https://fireworks.ai/pricing
#
# Format: fw_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
#
FIREWORKS_API_KEY=YOUR_FIREWORKS_API_KEY_HERE


# ----------------------------------------------------------------------------
# OPTION 11: Perplexity AI (Web-Connected Reasoning)
# ----------------------------------------------------------------------------
# Models with real-time web search built in. Useful when video topics
# require up-to-date factual context.
#
# Get your key : https://www.perplexity.ai/settings/api
# Pricing      : https://docs.perplexity.ai/docs/pricing
# Supported models: llama-3.1-sonar-large-128k-online, sonar-small-online
#
# Format: pplx-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
#
PERPLEXITY_API_KEY=YOUR_PERPLEXITY_API_KEY_HERE


# ----------------------------------------------------------------------------
# OPTION 12: xAI Grok (Real-Time & Long Context)
# ----------------------------------------------------------------------------
# Grok-2 from xAI with 128K context and strong instruction following.
# API access included with X Premium+ subscription.
#
# Get your key : https://console.x.ai/
# Docs         : https://docs.x.ai/
# Supported models: grok-2, grok-2-mini
#
# Format: xai-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
#
XAI_API_KEY=YOUR_XAI_API_KEY_HERE


# ----------------------------------------------------------------------------
# OPTION 13: Local — Ollama (Fully Private, No API Key Needed)
# ----------------------------------------------------------------------------
# Run models entirely on your own machine. Zero cost, 100% private.
# Requires Ollama to be installed and running locally.
#
# Install Ollama : https://ollama.com/download
# Model library  : https://ollama.com/library
# Quick start:
#   ollama pull llama3
#   ollama serve
#
# Usage: python clipify.py "video.mp4" --ai local
#
# Optional: Override default Ollama host/port
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3


# ============================================================================
# SYSTEM CONFIGURATION
# ============================================================================

# Path to ffmpeg binary — leave empty to auto-detect from PATH
# Windows : C:\ffmpeg\bin\ffmpeg.exe
# macOS   : /usr/local/bin/ffmpeg  (Homebrew) or /opt/homebrew/bin/ffmpeg (M1)
# Linux   : /usr/bin/ffmpeg
FFMPEG_PATH=

# Path to YouTube cookies file for authenticated downloads (age-restricted, etc.)
# Export cookies from your browser using a browser extension, e.g. "Get cookies.txt LOCALLY"
YOUTUBE_COOKIES_PATH=./cookies.txt

# Optional HTTP/HTTPS proxy for all outbound requests (useful in restricted networks)
# Format: http://user:pass@host:port  or  socks5://host:port
# HTTP_PROXY=
# HTTPS_PROXY=

# Enable anti-hallucination / safe processing mode:
#   true | false
ANTI_HALLUCINATION=false

# ============================================================================
# VIDEO PROCESSING SETTINGS
# ============================================================================

# Default number of clips to extract per video (1–100)
DEFAULT_CLIPS=10

# Output video quality: low | medium | high
DEFAULT_QUALITY=high

# Output aspect ratio: 9:16 (vertical/TikTok) | 16:9 (landscape) | 1:1 (square)
DEFAULT_FORMAT=9:16

# Clip duration bounds (seconds)
MIN_CLIP_LENGTH=2.0
MAX_CLIP_LENGTH=30.0

# Minimum "interest score" a segment must reach to be selected as a clip (0.0–1.0)
# Lower values = more clips selected; higher = only the most engaging segments
MIN_INTEREST_SCORE=0.5

# Burn subtitles into output clips: true | false
BURN_SUBTITLES=false

# Font size for burned-in subtitles (pixels)
SUBTITLE_FONT_SIZE=48


# ============================================================================
# PERFORMANCE SETTINGS
# ============================================================================

# Number of parallel processing workers (set to CPU core count for best results)
MAX_WORKERS=4

# HTTP request timeout in seconds (increase for slow connections)
TIMEOUT_SECONDS=300

# Enable GPU acceleration for video encoding (requires CUDA or VideoToolbox)
USE_GPU=false

# Directory for temporary cache files
CACHE_DIR=./cache

# Directory for final output clips
OUTPUT_DIR=./output

# Maximum disk space to use for cache before auto-cleanup (MB)
MAX_CACHE_SIZE_MB=5000


# ============================================================================
# WHISPER CONFIGURATION (TRANSCRIPTION)
# ============================================================================

# Whisper model size — trade-off between speed and accuracy:
#   tiny   ~75MB  | fastest  | lower accuracy  | good for quick drafts
#   base   ~150MB | fast     | decent accuracy | recommended default
#   small  ~500MB | moderate | good accuracy   | good balance
#   medium ~1.5GB | slow     | high accuracy   | recommended for production
#   large  ~3GB   | slowest  | best accuracy   | use when quality is critical
WHISPER_MODEL=base

# Whisper backend: local (uses faster-whisper on CPU/GPU) | openai (uses OpenAI API)
WHISPER_BACKEND=local

# Language hint for transcription — speeds up Whisper and improves accuracy
# Use ISO 639-1 codes: en, es, fr, de, zh, hi, ar, pt, ja, ko, etc.
# Leave empty for automatic language detection
WHISPER_LANGUAGE=

# Transcription device: cpu | cuda | mps (Apple Silicon)
WHISPER_DEVICE=cpu


# ============================================================================
# LOGGING & DEBUG
# ============================================================================

# Log verbosity: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Print detailed progress to console
VERBOSE=false

# Save debug output to a log file (leave empty to disable)
DEBUG_LOG_FILE=./debug.log

# Retain raw transcript JSON files after processing (useful for debugging)
KEEP_TRANSCRIPTS=false


# ============================================================================
# ADVANCED OPTIONS
# ============================================================================

# Maximum retry attempts for failed downloads
MAX_RETRIES=3

# Delay between retry attempts (seconds)
RETRY_DELAY=5

# Skip videos that have already been processed (based on output directory)
SKIP_ALREADY_PROCESSED=true

# Save per-video metadata JSON files alongside output clips
STORE_METADATA=true

# Maximum video duration to process (minutes) — set 0 for unlimited
MAX_VIDEO_DURATION_MINUTES=0

# Strip audio from output clips (video only): true | false
MUTE_OUTPUT=false
